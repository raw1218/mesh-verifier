# mv_embed(<output .cpp> <function> <files...>)
#
# Writes a C++ source defining `const std::map<std::string, std::string>& mesh_verifier::<function>()`: each file's
# name (without its directory) to its text. The text is split into pieces: MSVC limits one string literal to 16 KB.
# The files must not contain the sequence )MVEMBED" .
function(mv_embed out function)
    set(entries "")
    foreach(path IN LISTS ARGN)
        file(READ "${path}" text)
        get_filename_component(name "${path}" NAME)
        string(LENGTH "${text}" length)
        set(pieces "")
        set(at 0)
        while(at LESS length)
            string(SUBSTRING "${text}" ${at} 8000 piece)
            string(APPEND pieces "\n         R\"MVEMBED(${piece})MVEMBED\"")
            math(EXPR at "${at} + 8000")
        endwhile()
        if(pieces STREQUAL "")
            set(pieces " \"\"")
        endif()
        string(APPEND entries "\n        {\"${name}\",${pieces}},")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
    endforeach()
    file(WRITE "${out}" "// Generated by CMake (cmake/Embed.cmake). Do not edit.
#include <map>
#include <string>

namespace mesh_verifier {

const std::map<std::string, std::string>& ${function}() {
    static const std::map<std::string, std::string> files{${entries}
    };
    return files;
}

}  // namespace mesh_verifier
")
endfunction()
